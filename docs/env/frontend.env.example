# 本地联调配置；生产构建时由 CI/CD 注入同名变量
# 留空即走 Vite 代理（VITE_API_PROXY）；要连 Apifox Mock 就填 Mock 环境的完整地址
VITE_API_BASE_URL=/api/v1

# 可选。多后端线路，英文逗号分隔（如 https://api-a.example.com,https://api-b.example.com）；
# 配置后优先于 VITE_API_BASE_URL：首次进入并发探测所有线路，选延迟最低的，会话内保持。
# 单条地址、本地联调或演示站不用填。
VITE_API_BASE_URLS=

# 仅供 npm run dev 的 Vite 代理使用，生产构建不读取
VITE_API_PROXY=http://localhost:8000

# 可选。子路径部署前缀（如 /Electrical-Manager/demo/），会写进 Vite base；
# 留空即 '/'，与根路径部署行为一致
VITE_BASE_PATH=
