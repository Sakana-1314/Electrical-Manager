# External PostgreSQL on 1panel-network. Replace "postgresql" with its container name.
# Create the database first and URL-encode special characters in the password.
APP_DATABASE_URL=postgresql+asyncpg://materials_user:change-me@postgresql:5432/materials_manager
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_ACCESS_TOKEN_MINUTES=480
# Optional dedicated key for encrypting API Key / webhook secrets (Fernet).
# Leave empty to fall back to a key derived from APP_JWT_SECRET (keeps existing encrypted values readable).
APP_FERNET_KEY=
# Multiple mini programs use matching comma-separated positions.
APP_WECHAT_MINI_PROGRAM_APP_ID=wx-app-id-1,wx-app-id-2
APP_WECHAT_MINI_PROGRAM_APP_SECRET=app-secret-1,app-secret-2
# 网页端站点地址（小程序「进入网页版」直接拼 /web-open?token=…）；留空则回退一次性票据。
APP_WEB_BASE_URL=
APP_LOG_BACKUP_COUNT=90

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
