APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+asyncpg://spare:spare@localhost:5432/spare_parts
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_ACCESS_TOKEN_MINUTES=30
APP_REFRESH_TOKEN_DAYS=7
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=86400
# 多个小程序按相同顺序用英文逗号分隔。
APP_WECHAT_MINI_PROGRAM_APP_ID=wx-app-id-1,wx-app-id-2
APP_WECHAT_MINI_PROGRAM_APP_SECRET=app-secret-1,app-secret-2
# 小程序码环境：trial / release（默认 release）；AppID 取上面第一个已配置项。
APP_WECHAT_MINI_PROGRAM_CODE_ENV=release

# AI 搜索（OpenAI 兼容端点）：管理端不再配置，只读环境变量。
APP_AI_SEARCH_ENABLED=false
APP_AI_SEARCH_ENDPOINT=https://api.deepseek.com/v1
APP_AI_SEARCH_API_KEY=
APP_AI_SEARCH_MODEL=deepseek-chat

# 飞书 / 钉钉机器人推送：管理端不再配置，地址 / 密钥 / 订阅事件都在这里。
# 订阅事件用英文逗号分隔：stock.outbound.created,stock.inbound.created,mini_program.user.bound
APP_FEISHU_WEBHOOK_ENABLED=false
APP_FEISHU_WEBHOOK_URL=
APP_FEISHU_WEBHOOK_SECRET=
APP_FEISHU_WEBHOOK_EVENTS=
APP_DINGTALK_WEBHOOK_ENABLED=false
APP_DINGTALK_WEBHOOK_URL=
APP_DINGTALK_WEBHOOK_SECRET=
APP_DINGTALK_WEBHOOK_EVENTS=

APP_LOG_DIR=./data/logs
APP_LOG_BACKUP_COUNT=90
# 缩略图渲染：并发上限（默认 6）与缓存目录（独立于上传目录，可单独清理）
APP_PREVIEW_CONCURRENCY=6
APP_PREVIEW_CACHE_DIR=./data/preview-cache
