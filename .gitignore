# Python server
server/.venv/
server/**/__pycache__/
server/.pytest_cache/
server/.pytest-run-*/
server/.mypy_cache/
server/.ruff_cache/
server/data/uploads/*
!server/data/uploads/.gitkeep
server/data/logs/
server/data/template/

# Web
web/node_modules/
# worktree 里 node_modules 常以软链复用主检出，尾斜杠匹配不到软链，这里单独兜一条
web/node_modules
web/dist/
web/.env
web/.env.local

# Local configuration and databases
.env
docs/env/.env
server/.env
server/*.db

# 本地 git worktree（每个功能分支一个工作树，不进入版本库）
.worktrees/

# other
outputs/
*.log

# 项目站点（VitePress）
docs/websites/node_modules/
docs/websites/.vitepress/cache/
docs/websites/.vitepress/dist/
