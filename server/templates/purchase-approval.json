{
  "schema_version": 1,
  "template_name": "申购审批表模板",
  "output_filename": "采购申请（审批）_{date_compact}.xlsx",
  "sheet": {
    "title": "申购审批表",
    "header_row": 1,
    "data_start_row": 2,
    "freeze_panes": "A2",
    "column_widths": {
      "A": 9.0,
      "B": 17.67,
      "C": 15.5,
      "D": 18.67,
      "E": 9.67,
      "F": 8.67,
      "G": 13.33,
      "H": 24.16,
      "I": 16.84,
      "J": 12.0,
      "K": 12.0,
      "L": 13.33,
      "M": 13.33,
      "N": 13.33,
      "O": 11.5,
      "P": 24.16,
      "Q": 7.33,
      "R": 14.0
    }
  },
  "styles": {
    "header": {
      "font_name": "等线",
      "font_size": 11,
      "bold": true,
      "fill": "D9EAD3",
      "horizontal": "center",
      "vertical": "center",
      "wrap_text": true,
      "border": true
    },
    "data": {
      "font_name": "等线",
      "font_size": 11,
      "horizontal": "center",
      "vertical": "center",
      "wrap_text": true,
      "border": true
    },
    "date": {
      "font_name": "等线",
      "font_size": 11,
      "horizontal": "center",
      "vertical": "center",
      "number_format": "yyyy/m/d",
      "border": true
    }
  },
  "columns": [
    { "column": "A", "header": "序号", "field": "serial" },
    { "column": "B", "header": "物料编码", "field": "material_code" },
    { "column": "C", "header": "物料名称", "field": "name" },
    { "column": "D", "header": "型号", "field": "model_spec" },
    { "column": "E", "header": "申请数量", "field": "planned_qty" },
    { "column": "F", "header": "单位", "field": "unit_name" },
    { "column": "G", "header": "实际需求人", "field": "purchase_responsible" },
    { "column": "H", "header": "使用部门", "field": "department" },
    { "column": "I", "header": "用途", "field": "usage" },
    { "column": "J", "header": "库存量", "field": "stock_qty" },
    { "column": "K", "header": "在途量", "field": "in_transit_qty" },
    { "column": "L", "header": "单价" },
    { "column": "M", "header": "总价" },
    {
      "column": "N",
      "header": "到现场日期",
      "field": "required_arrival_date",
      "style": "date"
    },
    { "column": "O", "header": "紧急程度", "field": "urgency" },
    { "column": "P", "header": "备注", "field": "remark" },
    { "column": "Q", "header": "子项号", "field": "subitem_no" },
    { "column": "R", "header": "图片", "field": "images" }
  ]
}
