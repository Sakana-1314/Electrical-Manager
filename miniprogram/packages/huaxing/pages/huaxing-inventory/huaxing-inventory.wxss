/* 卡片骨架、分割线上下排版与箭头由 app.wxss 的 .list-card 通用件承担，这里只保留本页的列宽。 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  min-width: 190rpx;
}

/* 申购人列吃掉剩余宽度，把箭头推到卡片右侧（与其它列表页末列同一做法）。 */
.purchaser-item {
  flex: 1;
  min-width: 0;
}

/* 顶栏物料编码标签：编码过长时裁切，避免撑破顶栏（完整编码见详情页）。 */
.topline-code {
  max-width: 420rpx;
  overflow: hidden;
}
