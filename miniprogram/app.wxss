/**
 * TDesign 官方主题：浅色 / 深色由 `theme.wxss` 的 `prefers-color-scheme` 自动切换，
 * 不再有手动外观档位、themeClass 或运行时 JS 同步。
 */
@import "theme.wxss";

/**
 * 项目语义别名：页面与组件只引用 `--app-*`，取值全部来自官方主题的 `--td-*`，
 * 系统切换深色时颜色自动跟随，无需任何 JS。
 */
page, .page {
  /* 底色与结构 */
  --app-bg: var(--td-bg-color-page);
  --app-surface: var(--td-bg-color-container);
  --app-surface-soft: var(--td-bg-color-secondarycontainer);
  --app-form-surface: var(--td-bg-color-container);
  --app-control-surface: var(--td-bg-color-component);
  --app-card-border: var(--td-border-level-1-color);
  --app-border-strong: var(--td-border-level-2-color);
  --app-divider: var(--td-border-level-1-color);
  --app-page-glow: radial-gradient(circle at 100% 0%, var(--td-brand-color-light), transparent 28%);
  --app-surface-gradient: linear-gradient(135deg, var(--td-bg-color-container) 0%, var(--td-brand-color-light) 100%);
  --app-surface-gradient-soft: linear-gradient(145deg, var(--td-bg-color-container) 0%, var(--td-bg-color-secondarycontainer) 100%);
  --app-entry-gradient: linear-gradient(135deg, var(--td-brand-color-light) 0%, var(--td-bg-color-secondarycontainer) 100%);
  /* 主色 */
  --app-brand: var(--td-brand-color);
  --app-brand-active: var(--td-brand-color-active);
  --app-brand-disabled: var(--td-brand-color-disabled);
  --app-brand-soft: var(--td-brand-color-light);
  --app-brand-soft-active: var(--td-brand-color-light-active);
  --app-brand-border: var(--td-brand-color-2);
  --app-brand-text: var(--td-text-color-brand);
  --app-brand-icon: var(--td-brand-color);
  --app-brand-strong-gradient: linear-gradient(145deg, var(--td-brand-color-7), var(--td-brand-color-6));
  --app-on-brand: var(--td-text-color-anti);
  --app-on-brand-soft: var(--td-font-white-1);
  --app-on-brand-line: var(--td-font-white-4);
  --app-on-brand-glow: var(--td-font-white-4);
  --app-on-brand-ring: var(--td-font-white-4);
  --app-on-brand-ring-soft: var(--td-font-white-4);
  /* 阴影：用官方 table 阴影色，深色自动加深 */
  --app-shadow-color: var(--td-table-shadow-color);
  --app-shadow-color-strong: var(--td-table-shadow-color);
  --app-brand-shadow-color: var(--td-table-shadow-color);
  --app-brand-shadow-color-strong: var(--td-table-shadow-color);
  --app-brand-shadow-color-soft: var(--td-table-shadow-color);
  --app-brand-strong-shadow-color: var(--td-table-shadow-color);
  --app-brand-halo-color: var(--td-brand-color-light);
  /* 文本 */
  --app-text-strong: var(--td-text-color-primary);
  --app-text-title: var(--td-text-color-primary);
  --app-text: var(--td-text-color-secondary);
  --app-text-value: var(--td-text-color-primary);
  --app-text-secondary: var(--td-text-color-secondary);
  --app-text-muted: var(--td-text-color-placeholder);
  --app-text-subtle: var(--td-text-color-placeholder);
  --app-text-placeholder: var(--td-text-color-placeholder);
  /* 状态语义：直接使用 TDesign 的 success / warning / error */
  --app-status-success: var(--td-success-color);
  --app-status-success-soft: var(--td-success-color-light);
  --app-status-warning: var(--td-warning-color);
  --app-status-warning-soft: var(--td-warning-color-light);
  --app-status-danger: var(--td-error-color);
  --app-status-danger-soft: var(--td-error-color-light);
  --app-scrim: var(--td-mask-active);
  --app-transparent: transparent;
  /* TDesign 组件补充语义（官方主题未覆盖的部分） */
  --td-toast-bg-color: var(--td-mask-active);
  --td-toast-color: var(--td-text-color-anti);
  --td-popup-bg-color: var(--td-bg-color-container);
  --td-input-bg-color: var(--td-bg-color-container);
  --td-input-border-color: var(--td-border-level-1-color);
  --td-search-bg-color: var(--td-bg-color-secondarycontainer);
  --td-dropdown-menu-bg-color: var(--td-bg-color-container);
  --td-dropdown-menu-color: var(--td-text-color-secondary);
  --td-dropdown-menu-active-color: var(--td-brand-color);
  --td-picker-bg-color: var(--td-bg-color-container);
  --td-picker-title-color: var(--td-text-color-primary);
  --td-picker-cancel-color: var(--td-text-color-secondary);
  --td-picker-confirm-color: var(--td-brand-color);
  --td-picker-indicator-bg-color: var(--td-bg-color-secondarycontainer);
  --td-picker-item-color: var(--td-text-color-secondary);
  --td-picker-item-active-color: var(--td-text-color-primary);
  --td-picker-transparent-color: var(--app-transparent);
  /* 结构令牌：保留项目圆角，不随明暗变化 */
  --td-radius-default: 18rpx;
  --td-radius-large: 28rpx;
  --td-button-border-radius: 18rpx;
}

page {
  min-height: 100%;
  background: var(--app-bg);
  color: var(--app-text-strong);
  font-family: var(--td-font-family), sans-serif;
}

.page-shell {
  box-sizing: border-box;
  /* 导航栏由 app-navbar 在页面外占位：再设 100vh 会把页面撑出一屏多余滚动。 */
  padding: 36rpx 32rpx;
  background:
    var(--app-page-glow),
    var(--app-bg);
  color: var(--app-text-strong);
}

.page-header {
  margin: 8rpx 4rpx 32rpx;
}

.page-eyebrow {
  margin-bottom: 10rpx;
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.page-title {
  color: var(--app-text-strong);
  font-size: 48rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.page-description {
  margin-top: 12rpx;
  color: var(--app-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 28rpx;
  background: var(--app-surface);
  box-shadow: 0 16rpx 48rpx var(--app-shadow-color);
}

.section-heading {
  padding: 30rpx 32rpx 22rpx;
}

.section-title {
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.section-description {
  margin-top: 8rpx;
  color: var(--app-text-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.section-divider {
  height: 2rpx;
  margin: 0 32rpx;
  background: var(--app-card-border);
}

.primary-action {
  margin-top: 32rpx;
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color);
}
