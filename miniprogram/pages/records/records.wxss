/* 卡片骨架与分割线由 app.wxss 的 .list-card 通用件承担。
 * 操作记录没有详情页：卡片不可点、不带箭头，分割线下方是逐行的字段明细。 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-no {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--app-text-secondary);
  font-size: 23rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-line {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.detail-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}

.detail-label {
  flex: none;
  width: 120rpx;
  color: var(--app-text-subtle);
  font-size: 21rpx;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 550;
  line-height: 1.45;
  word-break: break-all;
}
