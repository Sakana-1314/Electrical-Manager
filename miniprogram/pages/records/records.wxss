/* 卡片骨架与分割线上下排版由 app.wxss 的 .list-card 通用件承担。
 * 操作记录没有详情页：卡片不可点、不带箭头。数量 / 库存变化走通用数据区，
 * 用途 / 领用人 / 子项号 / 单号这类逐行明细紧跟数据区（detail-list）。 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  min-width: 190rpx;
}

.change-item {
  flex: 1;
  min-width: 0;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.detail-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}

.detail-label {
  flex: none;
  width: 120rpx;
  color: var(--app-text-subtle);
  font-size: 21rpx;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 550;
  line-height: 1.45;
  word-break: break-all;
}
