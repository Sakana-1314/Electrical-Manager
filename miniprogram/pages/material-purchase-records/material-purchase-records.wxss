/* 卡片骨架、分割线上下排版与箭头由 app.wxss 的 .list-card 通用件承担。 */
.material-caption {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 20rpx;
  background: var(--app-surface-soft);
}

.caption-name {
  color: var(--app-text-strong);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.caption-code {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.failed-panel {
  flex-direction: column;
  gap: 24rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  min-width: 190rpx;
}

.responsible-item {
  flex: 1;
  min-width: 0;
}
