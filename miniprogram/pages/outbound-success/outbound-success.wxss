.success-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.success-result {
  margin: 8rpx 0 28rpx;
}

.material-card {
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: var(--app-brand-strong-gradient);
  box-shadow: 0 18rpx 44rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.material-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.material-spec {
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--app-on-brand-line);
}

.stock-label {
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
}

.quantity-value {
  margin-top: 4rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.quantity-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 550;
  color: var(--app-on-brand-soft);
}

.after-block {
  text-align: right;
}

.after-value {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.2;
}

.detail-card .section-heading {
  padding: 18rpx 22rpx;
}

.detail-card .section-divider {
  margin: 0 22rpx;
}

.detail-list {
  padding: 4rpx 22rpx 10rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  width: 160rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-value);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.success-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.success-action {
  flex: 1;
  min-width: 0;
}

.finish-action {
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color);
}
