<app-navbar title="{{i18n.outboundSuccessTitle}}" back="{{false}}" />
<view class="page-shell success-page">
  <view wx:if="{{loading}}" class="success-result">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingGeneric}}" />
  </view>

  <view wx:elif="{{result}}" class="success-result">
    <t-result
      theme="success"
      title="{{i18n.outboundSuccessTitle}}"
      description="{{i18n.outboundSuccessDescription}}"
    />
  </view>

  <view wx:if="{{result}}" class="material-card">
    <view class="summary-heading">
      <view class="material-name"><text user-select="{{true}}">{{result.material_name}}</text></view>
    </view>
    <view class="material-spec"><text user-select="{{true}}">{{result.model_spec}}</text></view>
    <view class="stock-block">
      <view>
        <view class="stock-label">{{i18n.outboundQuantity}}</view>
        <view class="quantity-value"><text user-select="{{true}}">{{result.quantity}}<text class="quantity-unit">{{result.unit_name}}</text></text></view>
      </view>
      <view class="after-block">
        <view class="stock-label">{{i18n.remainingStock}}</view>
        <view class="after-value"><text user-select="{{true}}">{{result.after_qty}} {{result.unit_name}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{result}}" class="section-card detail-card">
    <view class="section-heading">
      <view class="section-title">{{i18n.outboundDetail}}</view>
    </view>
    <view class="section-divider"></view>
    <view class="detail-list">
      <view class="detail-row">
        <view class="detail-label">{{i18n.outboundNo}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.operation_no}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.outboundQuantity}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.quantity}} {{result.unit_name}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.stockChange}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.before_qty}} → {{result.after_qty}} {{result.unit_name}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.subitemNo}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.subitem_no_label}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.outboundPurpose}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.business_reason}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.receiverName}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.receiver_name_label}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.executedBy}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.executed_by}}</text></view>
      </view>
      <view class="detail-row">
        <view class="detail-label">{{i18n.outboundTime}}</view>
        <view class="detail-value"><text user-select="{{true}}">{{result.occurred_at_label}}</text></view>
      </view>
    </view>
  </view>

  <view class="success-actions">
    <t-button
      class="success-action home-action"
      theme="default"
      variant="outline"
      size="large"
      icon="home"
      bind:tap="goHome"
    >{{i18n.goHome}}</t-button>
    <t-button
      class="success-action finish-action"
      theme="primary"
      size="large"
      icon="scan"
      bind:tap="continueScan"
    >{{i18n.continueScan}}</t-button>
  </view>

  <t-toast id="outbound-success-toast" />
</view>
