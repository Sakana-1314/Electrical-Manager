/* 卡片骨架、分割线、箭头与状态标签由 app.wxss 的 .list-card 通用件承担；这里只管工具条排布。 */
.stock-materials-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.toolbar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.material-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  flex: 1;
  min-width: 0;
}
