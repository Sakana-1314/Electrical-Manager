<app-navbar title="{{i18n.purchasePlansTitle}}" />
<view class="page-shell list-page">
  <view class="list-tools">
    <filter-panel
      keyword="{{keyword}}"
      placeholder="{{i18n.purchasePlanSearchPlaceholder}}"
      sections="{{filterSections}}"
      active="{{filters}}"
      options-failed="{{optionsFailed}}"
      bind:retryoptions="onRetryOptions"
      field-defs="{{fieldDefs}}"
      field-values="{{fieldValues}}"
      bind:search="onSearchChange"
      bind:change="onFilterChange"
    />
  </view>
  <view wx:if="{{items.length}}" class="result-count">{{resultCount}}</view>
  <view wx:if="{{loading && !items.length}}" class="state-panel">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingPurchasePlans}}" />
  </view>
  <view wx:elif="{{!items.length}}" class="state-panel empty-panel">
    <t-empty icon="file" description="{{keyword || filtered ? i18n.purchasePlansEmptyFiltered : i18n.purchasePlansEmpty}}" />
  </view>
  <view wx:else class="plan-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="list-card"
      hover-class="list-card-active"
      data-id="{{item.id}}"
      bind:tap="openDetail"
    >
      <view class="card-topline">
        <view class="card-date">{{item.plan_date_label}}</view>
        <view class="topline-right">
          <t-tag theme="{{item.urgency_theme}}" variant="light" size="small">{{item.urgency}}</t-tag>
        </view>
      </view>
      <view class="card-heading">
        <view class="material-name">{{item.name}}</view>
      </view>
      <view wx:if="{{item.model_spec}}" class="material-spec">{{item.model_spec}}</view>
      <view class="card-divider"></view>
      <view class="card-meta">
        <view class="meta-item">
          <view class="meta-label">{{i18n.plannedQuantity}}</view>
          <view class="quantity-value">{{item.quantity}}<text wx:if="{{item.quantity_unit}}" class="quantity-unit">{{item.quantity_unit}}</text></view>
        </view>
        <view class="meta-item responsible-item">
          <view class="meta-label">{{i18n.actualDemandPerson}}</view>
          <view class="meta-value">{{item.actual_demand_person}}</view>
        </view>
        <t-icon class="card-arrow" name="chevron-right" size="36rpx" />
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="load-more">
    <t-loading theme="circular" size="36rpx" text="{{i18n.loadMore}}" />
  </view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-finished">{{i18n.noMore}}</view>
  <t-toast id="purchase-plans-toast" />
  <button
    wx:if="{{backTopVisible}}"
    class="back-top-fab"
    aria-label="{{i18n.backToTop}}"
    bind:tap="scrollToTop"
  >
    <t-icon name="backtop" size="52rpx" />
  </button>
</view>
