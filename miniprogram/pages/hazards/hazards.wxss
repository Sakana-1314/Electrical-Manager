/* 卡片骨架、分割线上下排版与箭头由 app.wxss 的 .list-card 通用件承担。
 * 隐患卡数据区是三列等宽（区域 / 整改人 / 期限），没有主数量列。 */
.hazard-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  flex: 1;
  min-width: 0;
}

.hazard-description {
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
}

.hazard-meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.hazard-type {
  color: var(--app-text-muted);
  font-size: 24rpx;
}
