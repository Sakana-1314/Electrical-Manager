/* 卡片骨架、分割线上下排版与箭头由 app.wxss 的 .list-card 通用件承担。
 * 隐患卡没有数量列：数据区是三列等宽（区域 / 整改人 / 期限）；标题用通用 .material-name。
 * 标题下的等级 tag + 隐患类型行对应其它列表卡的「型号规格」位置。 */
.hazard-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  flex: 1;
  min-width: 0;
}

.hazard-meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.hazard-type {
  color: var(--app-text-muted);
  font-size: 24rpx;
}
