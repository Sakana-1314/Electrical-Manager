.hazards-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-tools {
  margin-bottom: 20rpx;
  padding: 0;
}

.result-count {
  margin: 0 8rpx 14rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
}

.hazard-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hazard-card {
  padding: 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 24rpx;
  background: var(--app-surface);
  box-shadow: 0 10rpx 30rpx var(--app-shadow-color);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.hazard-card-active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 18rpx var(--app-shadow-color-strong);
}

.card-topline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-date {
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.topline-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}

.card-heading {
  margin-top: 14rpx;
}

.hazard-description {
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
}

.hazard-meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.hazard-type {
  color: var(--app-text-muted);
  font-size: 24rpx;
}

.card-divider {
  height: 2rpx;
  margin: 22rpx 0 18rpx;
  background: var(--app-divider);
}

.hazard-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  min-width: 0;
  flex: 1;
}

.meta-label {
  color: var(--app-text-subtle);
  font-size: 21rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 550;
  word-break: break-all;
}

.state-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
}

.empty-panel {
  padding-top: 40rpx;
}

.load-more,
.load-finished {
  padding: 28rpx 0 8rpx;
  color: var(--app-text-placeholder);
  font-size: 22rpx;
  text-align: center;
}
