/* 网页扫码登录确认页：只做身份确认，不展示业务数据。 */
.web-login-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.detail-state {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.failed-state {
  flex-direction: column;
  gap: 24rpx;
}

.web-login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
}

.web-login-icon {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.web-login-title {
  color: var(--app-text-strong);
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.35;
}

.web-login-desc {
  max-width: 560rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.web-login-user {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin: 8rpx 0 4rpx;
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 600;
}

.web-login-department {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 400;
}

.web-login-success {
  color: var(--app-brand-text);
  font-size: 24rpx;
  line-height: 1.5;
}
