.disabled-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.disabled-card {
  width: 100%;
  padding: 40rpx 20rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 28rpx;
  background: var(--app-surface);
  box-shadow: 0 16rpx 48rpx var(--app-shadow-color);
}
