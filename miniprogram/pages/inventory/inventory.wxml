<app-navbar title="{{i18n.inventoryTitle}}" />
<view class="page-shell list-page">
  <view wx:if="{{lastImportAtLabel}}" class="import-time">{{i18n.importTimeLabel}}：{{lastImportAtLabel}}</view>

  <view class="list-tools">
    <filter-panel
      keyword="{{keyword}}"
      placeholder="{{i18n.searchPlaceholder}}"
      sections="{{filterSections}}"
      active="{{filters}}"
      field-defs="{{fieldDefs}}"
      field-values="{{fieldValues}}"
      bind:search="onSearchChange"
      bind:change="onFilterChange"
    />
  </view>

  <view wx:if="{{!loading || items.length}}" class="result-count">{{resultCount}}</view>

  <view wx:if="{{loading && !items.length}}" class="state-panel">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingInventory}}" />
  </view>

  <view wx:elif="{{!items.length}}" class="state-panel empty-panel">
    <t-empty icon="search" description="{{keyword || filtered ? i18n.inventoryEmptyFiltered : i18n.inventoryEmpty}}" />
  </view>

  <view wx:else class="inventory-list">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="list-card"
      hover-class="list-card-active"
      data-uuid="{{item.uuid}}"
      bind:tap="openDetail"
    >
      <view class="card-heading">
        <view class="material-name">{{item.name}}</view>
        <t-tag wx:if="{{item.stock_status}}" theme="{{item.stock_status_theme}}" variant="light" size="small">
          {{item.stock_status_label}}
        </t-tag>
      </view>
      <view wx:if="{{item.model_spec}}" class="material-spec">{{item.model_spec}}</view>
      <view class="card-divider"></view>
      <view class="card-meta">
        <view class="meta-item">
          <view class="meta-label">{{i18n.stockQuantity}}</view>
          <view class="quantity-value">{{item.current_qty}}</view>
        </view>
        <view class="meta-item unit-item">
          <view class="meta-label">{{i18n.unit}}</view>
          <view class="meta-value">{{item.unit_name}}</view>
        </view>
        <t-icon wx:if="{{!item.is_lite}}" class="card-arrow" name="chevron-right" size="36rpx" />
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">
    <t-loading theme="circular" size="36rpx" text="{{i18n.loadMore}}" />
  </view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-finished">{{i18n.noMore}}</view>
  <t-toast id="inventory-toast" />
  <button
    wx:if="{{backTopVisible}}"
    class="back-top-fab"
    aria-label="{{i18n.backToTop}}"
    bind:tap="scrollToTop"
  >
    <t-icon name="backtop" size="52rpx" />
  </button>
</view>
