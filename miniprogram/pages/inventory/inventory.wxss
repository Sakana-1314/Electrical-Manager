/* 卡片骨架、分割线上下排版与箭头由 app.wxss 的 .list-card 通用件承担，这里只保留本页的列宽。 */
.inventory-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  min-width: 190rpx;
}

/* 搜索下方的操作条：扫码入库 / 出入库记录入口（二级库 Pro 才有）。 */
.toolbar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
