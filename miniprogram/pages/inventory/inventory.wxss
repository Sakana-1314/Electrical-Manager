.inventory-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.inventory-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 4rpx 4rpx 24rpx;
}

.inventory-header .page-title {
  font-size: 44rpx;
}

.inventory-tools {
  --td-tab-nav-bg-color: transparent;
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.result-count {
  margin: 0 8rpx 14rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
}

.inventory-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.inventory-card {
  padding: 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 24rpx;
  background: var(--app-surface);
  box-shadow: 0 10rpx 30rpx var(--app-shadow-color);
  transition: transform 120ms ease, background 120ms ease;
}

.inventory-card-active {
  transform: scale(0.99);
  background: var(--app-surface-soft);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.material-name {
  flex: 1;
  min-width: 0;
  color: var(--app-text-strong);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.material-spec {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.spec-label {
  flex: none;
  color: var(--app-text-placeholder);
}

.card-divider {
  height: 2rpx;
  margin: 20rpx 0 16rpx;
  background: var(--app-divider);
}

.inventory-meta {
  display: flex;
  align-items: flex-end;
}

.meta-item {
  min-width: 180rpx;
}

.unit-item {
  flex: 1;
}

.meta-label {
  color: var(--app-text-subtle);
  font-size: 21rpx;
}

.stock-quantity {
  margin-top: 4rpx;
  color: var(--app-brand-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.meta-value {
  margin-top: 8rpx;
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 550;
}

.card-arrow {
  color: var(--app-text-placeholder);
}

.state-panel {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.empty-panel {
  padding-top: 40rpx;
  box-sizing: border-box;
}

.load-more,
.load-finished {
  padding: 28rpx 0 8rpx;
  color: var(--app-text-placeholder);
  font-size: 22rpx;
  text-align: center;
}
