<view class="page-shell ledger-detail-page {{themeClass}}">
  <view wx:if="{{loading}}" class="detail-state">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingLedgerDetail}}" />
  </view>
  <view wx:elif="{{failed}}" class="detail-state failed-state">
    <t-empty icon="error-circle" description="{{i18n.ledgerDetailFailed}}" />
    <t-button theme="primary" variant="outline" size="small" bind:tap="retry">{{i18n.reload}}</t-button>
  </view>
  <block wx:elif="{{record}}">
    <view class="summary-card">
      <view class="summary-name">{{record.name}}</view>
      <view class="summary-spec">{{record.model_spec}}</view>
      <view class="summary-footer">
        <view>
          <view class="summary-label">{{i18n.subitemNo}}</view>
          <view class="summary-value">{{record.subitem_no_label}}</view>
        </view>
        <view class="quantity-block">
          <view class="summary-label">{{i18n.quantityLabel}}</view>
          <view class="quantity-value">{{record.quantity_label}}</view>
        </view>
      </view>
    </view>

    <view class="section-card detail-card">
      <view class="section-heading"><view class="section-title">{{i18n.ledgerInfo}}</view></view>
      <view class="section-divider"></view>
      <view class="detail-list">
        <view class="detail-row"><view class="detail-label">{{i18n.modelSpecLabel}}</view><view class="detail-value">{{record.model_spec}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.subitemNo}}</view><view class="detail-value">{{record.subitem_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.quantityLabel}}</view><view class="detail-value">{{record.quantity_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.usage}}</view><view class="detail-value">{{record.usage}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.remark}}</view><view class="detail-value">{{record.remark_label}}</view></view>
      </view>
    </view>

    <view class="section-card tag-card">
      <view class="section-heading">
        <view class="section-title">{{i18n.ledgerTags}}</view>
        <view class="tag-count">{{record.tag_count_label}}</view>
      </view>
      <view class="section-divider"></view>
      <view wx:if="{{record.tags.length}}" class="tag-list">
        <t-tag
          wx:for="{{record.tags}}"
          wx:key="id"
          class="ledger-tag"
          theme="primary"
          variant="light"
          size="medium"
        >{{item.path}}</t-tag>
      </view>
      <view wx:else class="empty-hint">{{i18n.noTags}}</view>
    </view>

    <view class="section-card image-card">
      <view class="section-heading">
        <view class="section-title">{{i18n.imageAttachments}}</view>
        <view class="image-count">{{record.image_count_label}}</view>
      </view>
      <view class="section-divider"></view>
      <view wx:if="{{record.images.length}}" class="image-grid">
        <view wx:for="{{record.images}}" wx:key="id" class="image-item" data-index="{{index}}" bind:tap="previewImage">
          <image class="ledger-image" src="{{item.preview_url}}" mode="aspectFill" lazy-load webp />
        </view>
      </view>
      <view wx:else class="empty-hint">{{i18n.noImages}}</view>
    </view>
  </block>
  <t-toast id="ledger-detail-toast" />
</view>
