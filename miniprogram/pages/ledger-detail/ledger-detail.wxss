.ledger-detail-page { padding: 24rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.detail-state { display: flex; min-height: 72vh; align-items: center; justify-content: center; }
.failed-state { flex-direction: column; gap: 24rpx; }

.summary-card {
  margin-bottom: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: var(--app-brand-strong-gradient);
  box-shadow: 0 18rpx 44rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.summary-name {
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.summary-spec {
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.summary-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--app-on-brand-line);
}

.summary-label {
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
}

.summary-value {
  margin-top: 4rpx;
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 550;
  line-height: 1.2;
}

.quantity-block { text-align: right; }

.quantity-value {
  margin-top: 4rpx;
  color: var(--app-on-brand);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.detail-card { margin-bottom: 18rpx; }
.tag-card { margin-bottom: 18rpx; }
.detail-card .section-heading, .tag-card .section-heading, .image-card .section-heading { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; }
.detail-card .section-divider, .tag-card .section-divider, .image-card .section-divider { margin: 0 22rpx; }
.detail-list { padding: 4rpx 22rpx 10rpx; }
.detail-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 17rpx 0; border-bottom: 2rpx solid var(--app-divider); }
.detail-row:last-child { border-bottom: 0; }
.detail-label { flex: none; width: 160rpx; color: var(--app-text-subtle); font-size: 23rpx; line-height: 1.5; }
.detail-value { flex: 1; min-width: 0; color: var(--app-text-value); font-size: 24rpx; line-height: 1.5; text-align: right; word-break: break-all; }
.tag-count, .image-count { color: var(--app-text-secondary); font-size: 24rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 20rpx 22rpx; }
.ledger-tag { max-width: 100%; }
.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; padding: 20rpx 22rpx; }
.image-item { overflow: hidden; height: 192rpx; border-radius: 18rpx; background: var(--app-bg); }
.ledger-image { display: block; width: 100%; height: 100%; }
.empty-hint { padding: 32rpx 22rpx; color: var(--app-text-muted); font-size: 26rpx; text-align: center; }
