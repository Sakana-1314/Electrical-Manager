.outbound-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading-card {
  display: flex;
  min-height: 240rpx;
  align-items: center;
  justify-content: center;
}

.page-header {
  margin: 4rpx 4rpx 20rpx;
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 280rpx;
  margin-top: 4rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 999rpx;
  background: var(--app-brand-soft);
  transition: transform 120ms ease, background 120ms ease;
}

.operator-badge-active {
  transform: scale(0.97);
  background: var(--app-brand-soft-active);
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-brand);
  box-shadow: 0 0 0 6rpx var(--app-brand-halo-color);
}

.operator-name {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inventory-entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 24rpx;
  background: var(--app-entry-gradient);
  box-shadow: 0 10rpx 28rpx var(--app-brand-shadow-color-soft);
  transition: transform 120ms ease, background 120ms ease;
}

.inventory-entry-card-active {
  transform: scale(0.99);
  background: var(--app-brand-soft-active);
}

.inventory-entry-icon {
  display: flex;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  box-shadow: 0 10rpx 22rpx var(--app-brand-shadow-color);
}

.inventory-entry-content {
  flex: 1;
  min-width: 0;
}

.inventory-entry-title {
  color: var(--app-text-title);
  font-size: 28rpx;
  font-weight: 650;
}

.inventory-entry-description {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 22rpx;
}

.inventory-entry-arrow {
  display: flex;
  color: var(--app-brand-icon);
}

.user-profile-popup {
  box-sizing: border-box;
  width: 620rpx;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: var(--app-surface);
}

.user-profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.user-profile-title {
  margin: 18rpx 0 26rpx;
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.user-profile-list {
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  background: var(--app-surface-soft);
}

.user-profile-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.user-profile-row:last-child {
  border-bottom: 0;
}

.user-profile-label {
  flex: none;
  width: 120rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.user-profile-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-value);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.scan-card {
  padding: 32rpx;
  border-color: var(--app-brand-border);
  background: var(--app-surface-gradient-soft);
}

.scan-card-heading {
  margin-bottom: 28rpx;
}

.scan-kicker {
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 600;
}

.scan-title {
  margin-top: 8rpx;
  color: var(--app-text-strong);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.scan-action {
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color);
}

.form-card {
  --td-input-bg-color: var(--app-form-surface);
  --td-input-vertical-padding: 20rpx 24rpx;
  --td-input-label-text-font: 28rpx / 42rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --td-input-placeholder-text-font: 28rpx / 42rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.form-card .section-heading {
  padding: 20rpx 24rpx 14rpx;
}

.form-card .section-divider {
  margin: 0 24rpx;
}

.reason-shortcuts {
  padding: 12rpx 24rpx 14rpx;
  border-bottom: 2rpx solid var(--app-divider);
}

.reason-label {
  margin-bottom: 8rpx;
  color: var(--app-text-muted);
  font-size: 21rpx;
  line-height: 1.3;
}

.reason-scroll {
  width: 100%;
  white-space: nowrap;
}

.reason-tags {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 24rpx;
}

.outbound-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.outbound-action {
  flex: 1;
  min-width: 0;
}

