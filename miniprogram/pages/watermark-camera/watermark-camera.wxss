/* 水印相机：取景 / 评审 / 编辑弹层三层状态共用一套水印排版。
 * 颜色全部引用主题令牌（--app-* / --td-*），深浅色跟随系统；
 * 取景画面与照片水印上的白字属于「画面上叠加」的语义，用 --td-text-color-anti
 * 与 --td-font-white-* 令牌表达，不写颜色字面量。 */
.watermark-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部工具行：模式切换 + 水印设置入口 ===== */
.watermark-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 模式切换：两颗胶囊等宽，选中项用品牌软底强调。 */
.mode-switch {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--app-surface-soft);
}

.mode-item {
  flex: 1;
  min-width: 0;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-item-active {
  background: var(--app-surface);
  color: var(--app-brand-text);
  font-weight: 650;
  box-shadow: 0 6rpx 18rpx var(--app-shadow-color);
}

/* 设置入口：图标 + 文字的小按钮，与模式切换同一行右侧。 */
.setting-entry {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 999rpx;
  background: var(--app-surface);
  color: var(--app-text);
}

.setting-entry-active {
  background: var(--app-surface-soft);
}

.setting-entry-text {
  font-size: 24rpx;
  font-weight: 550;
}

/* ===== 取景：4:3 取景框，相机与实时水印都约束在框内 ===== */
.frame {
  position: relative;
  width: 100%;
  height: 133.33vw;
  max-height: 62vh;
  overflow: hidden;
  border-radius: 28rpx;
  background: var(--app-camera-bg);
}

.camera {
  width: 100%;
  height: 100%;
}

/* 实时水印叠加层：底部渐变 + 左下白字，逼近 Canvas 成品。 */
.live-mark {
  position: absolute;
  left: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  width: 100%;
  gap: 6rpx;
  padding: 90rpx 40rpx 50rpx;
  background: linear-gradient(0deg, var(--td-mask-active), var(--app-transparent));
  text-shadow: 0 2rpx 6rpx var(--td-mask-active);
}

.lm-time {
  color: var(--td-text-color-anti);
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.1;
}

.lm-sub {
  color: var(--td-font-white-1);
  font-size: 30rpx;
  line-height: 1.4;
}

.lm-matter {
  color: var(--td-text-color-anti);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

/* 评审小图上的水印按预览比例缩小：整层缩到 0.6 倍，字号同比收小。 */
.live-mark-small {
  gap: 4rpx;
  padding: 54rpx 24rpx 30rpx;
  transform-origin: left bottom;
}

.live-mark-small .lm-time {
  font-size: 38rpx;
}

.live-mark-small .lm-sub {
  font-size: 18rpx;
}

.live-mark-small .lm-matter {
  font-size: 24rpx;
}

/* ===== 变焦：画面内底部的预设档位，手势缩放时显示当前倍率 ===== */
.zoom-bar {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--td-mask-active);
  transform: translateX(-50%);
}

.zoom-step {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  color: var(--td-font-white-2);
  font-size: 26rpx;
}

.zoom-step-active {
  background: var(--app-brand);
  color: var(--td-text-color-anti);
  font-weight: 600;
}

.zoom-value {
  min-width: 120rpx;
  color: var(--td-text-color-anti);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

/* ===== 快门条：手电筒 / 快门 / 翻转 ===== */
.capture-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 0 32rpx;
}

.side-btn {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--app-surface-soft);
  color: var(--app-text-strong);
}

.shutter-box {
  display: flex;
  width: 140rpx;
  height: 140rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--app-brand-border);
  border-radius: 50%;
  background: var(--app-surface-soft);
}

.shutter {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--app-brand);
  transition: transform 100ms ease;
}

.shutter:active {
  transform: scale(0.9);
}

.shutter-busy {
  background: var(--app-brand-disabled);
}

.capture-hint {
  margin-top: 18rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
  text-align: center;
}

/* ===== 评审视图（先拍后写）：定格图 + 下方直接写地点与文案 ===== */
.review {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-stage {
  display: flex;
  justify-content: center;
  overflow: hidden;
}

.review-image {
  position: relative;
  width: 60vw;
  height: 80vw;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--app-camera-bg);
}

.review-img {
  width: 100%;
  height: 100%;
}

.review-form {
  padding: 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 28rpx;
  background: var(--app-surface);
  box-shadow: 0 16rpx 48rpx var(--app-shadow-color);
}

/* 键盘弹出时收紧表单内边距，给等比缩小的预览图多留空间。 */
.review-form-compact {
  padding-top: 16rpx;
}

/* ===== 地点 / 文案：灰底输入卡，两个输入框之间一条分割线 =====
 * 紧凑口径：字号 / 行高比整站正文小一档，上下留白收到一档，
 * 文案框只按内容长高（autosize 区间在页面 JS 里给），不占掉半屏。 */
.input-card {
  --td-input-vertical-padding: 14rpx 20rpx;
  --td-textarea-padding: 14rpx 20rpx;
  --td-textarea-label-color: var(--app-text-secondary);
  overflow: hidden;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: var(--app-surface-soft);
}

/* TDesign 的输入 / 文案正文没有字号令牌，靠页面样式压一档（组件是 apply-shared，页面样式能进来）。 */
.input-card .t-input__label:not(:empty),
.input-card .t-input__control,
.input-card .t-input__placeholder,
.input-card .t-textarea__label:not(:empty),
.input-card .t-textarea__wrapper-inner,
.input-card .t-textarea__placeholder {
  font-size: 26rpx;
  line-height: 38rpx;
}

/* 标签与正文之间默认左右各留 32rpx，收成一档。 */
.input-card .t-input__label:not(:empty) {
  margin-right: 16rpx;
}

.input-card .t-input__label:not(:empty) + .t-input__wrap {
  margin-left: 0;
}

.input-card .t-textarea__label:not(:empty) {
  padding-bottom: 6rpx;
}

/* 地图选点按钮跟着输入卡缩一档，避免把行高撑回 56rpx。 */
.input-card .t-button--size-extra-small {
  --td-button-extra-small-height: 48rpx;
  --td-button-extra-small-font: 600 24rpx / 34rpx var(--td-font-family);
  --td-button-extra-small-padding-horizontal: 18rpx;
}

.input-divider {
  height: 2rpx;
  margin: 0 20rpx;
  background: var(--app-divider);
}

/* ===== 常用词：横向滚动，点击插入到文案光标处；置顶顺序来自设置页 ===== */
.word-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  height: 64rpx;
  margin-top: 4rpx;
  white-space: nowrap;
}

.word-row {
  display: flex;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-start;
}

.word-chip {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 999rpx;
  background: var(--app-surface);
  color: var(--app-text);
  font-size: 24rpx;
  line-height: 1.3;
}

.word-chip-active {
  background: var(--app-surface-soft);
}

.word-chip-add {
  border-color: var(--app-brand-border);
  background: var(--app-brand-soft);
  color: var(--app-brand-text);
  font-weight: 600;
}

.word-empty {
  margin-top: 10rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
  line-height: 1.5;
}

/* ===== 编辑弹层（先写后拍） ===== */
.edit-form {
  padding: 30rpx 24rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--app-form-surface);
}

.edit-title {
  margin-bottom: 22rpx;
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

/* 合成画布不参与布局：2d canvas 必须有尺寸，这里钉在视口外。 */
.compose-canvas {
  position: fixed;
  top: 0;
  left: -9999px;
  width: 300px;
  height: 225px;
  pointer-events: none;
}
