.stock-inbound-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
}

/* 物资摘要：名称 / 型号 / 当前库存，与库存列表卡片同一层级。 */
.material-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 26rpx 32rpx 22rpx;
}

.material-name {
  color: var(--app-text);
  font-size: 32rpx;
  font-weight: 600;
}

.material-spec {
  color: var(--app-text-muted);
  font-size: 25rpx;
}

.material-divider {
  height: 2rpx;
  margin: 14rpx 0 12rpx;
  background: var(--app-divider);
}

.material-meta {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-label {
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.quantity-value {
  color: var(--app-text);
  font-size: 40rpx;
  font-weight: 600;
}

.quantity-unit {
  margin-left: 6rpx;
  color: var(--app-text-muted);
  font-size: 24rpx;
  font-weight: 400;
}

/* 成功后的单据信息：标签左、值右对齐，长单号可长按复制。 */
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--app-divider);
}

.result-row:last-of-type {
  border-bottom: 0;
}

.result-label {
  flex: none;
  color: var(--app-text-muted);
  font-size: 25rpx;
}

.result-value {
  min-width: 0;
  overflow: hidden;
  color: var(--app-text);
  font-size: 25rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-actions {
  padding: 20rpx 32rpx 28rpx;
}

.inbound-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.inbound-action {
  flex: 1;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 56rpx 32rpx;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
}

.empty-actions > * {
  flex: 1;
}
