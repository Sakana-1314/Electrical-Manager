.huaxing-inventory-detail-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.detail-state {
  display: flex;
  min-height: 72vh;
  align-items: center;
  justify-content: center;
}

.failed-state {
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  margin-bottom: 18rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: var(--app-brand-strong-gradient);
  box-shadow: 0 18rpx 44rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.summary-name {
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.summary-spec {
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.summary-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--app-on-brand-line);
}

.summary-label {
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
}

.summary-value {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.unit-block {
  text-align: right;
}

.unit-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 550;
  line-height: 1.2;
}

.section-card {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 2rpx solid var(--app-card-border);
  border-radius: 28rpx;
  background: var(--app-surface);
  box-shadow: 0 12rpx 32rpx var(--app-shadow-color);
}

.section-heading {
  padding: 18rpx 22rpx;
}

.section-title {
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 600;
}

.section-divider {
  height: 2rpx;
  margin: 0 22rpx;
  background: var(--app-divider);
}

.detail-list {
  padding: 4rpx 22rpx 10rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  width: 180rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-value);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}
