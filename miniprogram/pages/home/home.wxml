<app-navbar title="{{i18n.homeTitle}}" back="{{false}}" />
<view class="page-shell home-page">
  <!-- 品牌头图：渐变实底 + 轨道装饰，承载标题、身份入口与首页唯一主动作（扫一扫）。
       与绑定页的品牌面板同一套语言，首屏先立住品牌，再往下铺功能入口。 -->
  <view class="brand-panel">
    <view class="brand-orbit brand-orbit-large"></view>
    <view class="brand-orbit brand-orbit-small"></view>
    <view class="brand-top">
      <view class="brand-eyebrow">ELECTRICAL WORKSHOP</view>
      <view wx:if="{{user}}" class="operator-badge" hover-class="operator-badge-active" bind:tap="openProfile">
        <view class="operator-dot"></view>
        <view class="operator-name">{{user.display_name}}</view>
        <t-icon class="operator-chevron" name="chevron-right" size="24rpx" />
      </view>
    </view>
    <view class="brand-title">{{i18n.brandTitle}}</view>
    <view class="brand-subtitle">{{i18n.homeSubtitle}}</view>

    <!-- 登录态与功能配置返回前不渲染扫码入口：canScan 依赖功能配置，先渲染再收起会闪。 -->
    <block wx:if="{{featureReady}}">
      <!-- 扫一扫：首页唯一的主动作，整张卡片可点（不再嵌套「开始扫码」按钮）；
           放在头图内的玻璃卡里，与下方功能卡拉开层级。描述随权限变化：
           有出库写权限时进入出库确认，只有读权限时查看物资详情。 -->
      <view
        wx:if="{{canScan}}"
        class="scan-card"
        hover-class="scan-card-active"
        aria-role="button"
        aria-label="{{i18n.scanTitle}}"
        bind:tap="scanMaterial"
      >
        <view class="scan-icon">
          <t-icon class="{{scanning ? 'scan-spinner' : ''}}" name="{{scanning ? 'loading' : 'scan'}}" size="52rpx" />
        </view>
        <view class="scan-content">
          <view class="scan-title">{{i18n.scanTitle}}</view>
          <view class="scan-description">{{scanDescription}}</view>
        </view>
        <view class="scan-arrow">
          <t-icon name="chevron-right" size="32rpx" />
        </view>
      </view>
    </block>
  </view>

  <!-- 功能入口：全部入口平级展示，仅按功能开关隐藏；等登录态与功能配置都返回后一次性渲染。 -->
  <block wx:if="{{featureReady}}">
    <view class="section-label">
      <view class="section-label-bar"></view>
      <view class="section-label-text">{{i18n.featureEntries}}</view>
    </view>

    <view class="action-grid">
      <view wx:if="{{entryVisible.inventory}}" class="action-card" hover-class="action-card-active" bind:tap="openInventory">
        <view class="action-head">
          <view class="action-icon"><t-icon name="view-list" size="38rpx" /></view>
          <view class="action-title">{{i18n.allInventory}}</view>
        </view>
        <view class="action-description">{{i18n.inventoryDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.huaxing}}" class="action-card" hover-class="action-card-active" bind:tap="openHuaXingInventory">
        <view class="action-head">
          <view class="action-icon"><t-icon name="layers" size="38rpx" /></view>
          <view class="action-title">{{i18n.huaxingInventoryTitle}}</view>
        </view>
        <view class="action-description">{{i18n.huaxingInventoryDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.purchasePlans}}" class="action-card" hover-class="action-card-active" bind:tap="openPurchasePlans">
        <view class="action-head">
          <view class="action-icon"><t-icon name="file-attachment" size="38rpx" /></view>
          <view class="action-title">{{i18n.purchasePlans}}</view>
        </view>
        <view class="action-description">{{i18n.purchasePlansDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.purchaseRecords}}" class="action-card" hover-class="action-card-active" bind:tap="openPurchaseRecords">
        <view class="action-head">
          <view class="action-icon"><t-icon name="file-copy" size="38rpx" /></view>
          <view class="action-title">{{i18n.purchaseRecordsTitle}}</view>
        </view>
        <view class="action-description">{{i18n.purchaseRecordsDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.ledger}}" class="action-card" hover-class="action-card-active" bind:tap="openLedger">
        <view class="action-head">
          <view class="action-icon"><t-icon name="folder" size="38rpx" /></view>
          <view class="action-title">{{i18n.ledgerTitle}}</view>
        </view>
        <view class="action-description">{{i18n.ledgerDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.hazards}}" class="action-card" hover-class="action-card-active" bind:tap="openHazards">
        <view class="action-head">
          <view class="action-icon"><t-icon name="error-circle" size="38rpx" /></view>
          <view class="action-title">{{i18n.hazardsTitle}}</view>
        </view>
        <view class="action-description">{{i18n.hazardsDescription}}</view>
      </view>

      <view wx:if="{{entryVisible.materialCodes}}" class="action-card" hover-class="action-card-active" bind:tap="openMaterialCodes">
        <view class="action-head">
          <view class="action-icon"><t-icon name="tag" size="38rpx" /></view>
          <view class="action-title">{{i18n.materialCodesTitle}}</view>
        </view>
        <view class="action-description">{{i18n.materialCodesDescription}}</view>
      </view>
    </view>
  </block>

  <!-- 登录态 / 功能配置还没回来：只显示加载态，不提前渲染入口（入口需按配置过滤）。 -->
  <view wx:if="{{!featureReady && !loadFailed}}" class="state-panel">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingGeneric}}" />
  </view>

  <view wx:if="{{loadFailed}}" class="state-panel failed-panel">
    <t-empty icon="error-circle" description="{{i18n.requestFailed}}" />
    <t-button theme="primary" variant="outline" size="small" bind:tap="retryLoad">{{i18n.reload}}</t-button>
  </view>

  <t-toast id="home-toast" />

  <button class="share-fab" open-type="share" aria-label="{{i18n.shareApp}}">
    <t-icon name="share" size="52rpx" />
  </button>
</view>
