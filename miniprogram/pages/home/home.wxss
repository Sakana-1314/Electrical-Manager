.home-page {
  padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin: 4rpx 4rpx 28rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 300rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 999rpx;
  background: var(--app-brand-soft);
}

.operator-badge-active,
.action-card-active {
  transform: scale(0.98);
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-brand);
  box-shadow: 0 0 0 6rpx var(--app-brand-halo-color);
}

.operator-name {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-chevron {
  color: var(--app-brand-icon);
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

/* 首屏加载态：占住入口区域的高度，加载完成时入口一次性就位，不会把页面顶上去。 */
.state-panel {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.failed-panel {
  flex-direction: column;
  gap: 24rpx;
}

/* 扫码出库：整张卡可点的主入口，用主色实底与下方功能卡区分主次，
 * 版式与 .action-card 相同（左侧图标 + 右侧两行文案 + 箭头），不再是一块单独的大卡加嵌套按钮。 */
.scan-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: var(--app-brand-strong-gradient);
  box-shadow: 0 14rpx 32rpx var(--app-brand-strong-shadow-color);
  transition: transform 120ms ease;
}

.scan-card-active {
  transform: scale(0.98);
}

.scan-icon {
  display: flex;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--app-on-brand-glow);
  color: var(--app-on-brand);
}

/* 扫码中：图标原地旋转。t-loading 的默认色是主色，在实底卡片上看不清，
 * 这里直接用图标 + 自带配色，保证与卡片文字同色。 */
.scan-spinner {
  animation: scan-spin 900ms linear infinite;
}

@keyframes scan-spin {
  to {
    transform: rotate(360deg);
  }
}

.scan-content {
  flex: 1;
  min-width: 0;
}

.scan-title {
  color: var(--app-on-brand);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
}

.scan-description {
  margin-top: 6rpx;
  color: var(--app-on-brand-soft);
  font-size: 22rpx;
  line-height: 1.4;
}

.scan-chevron {
  flex: none;
  color: var(--app-on-brand-soft);
}

/* 入口分组的标题：把「扫码」与下方功能列表在视觉上分成两段，
 * 只做一行小字标签，不加卡片、不加描述，避免又占掉首屏。 */
.section-label {
  margin: 8rpx 4rpx 16rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
  font-weight: 600;
}

.action-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 18rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 22rpx;
  background: var(--app-surface-gradient);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-soft);
  transition: transform 120ms ease;
}

.action-icon {
  display: flex;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.action-content {
  flex: 1;
  min-width: 0;
}

.action-title {
  overflow: hidden;
  color: var(--app-text-title);
  font-size: 26rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.action-description {
  margin-top: 6rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--app-text-secondary);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: left;
}

.user-profile-popup {
  box-sizing: border-box;
  width: 620rpx;
  /* 小屏上内容（外观可选列表展开后）可能高过屏幕，让弹窗自身可滚动。 */
  max-height: 78vh;
  padding: 42rpx 34rpx 30rpx;
  overflow-y: auto;
  border-radius: 28rpx;
  background: var(--app-surface);
}

.user-profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.user-profile-title {
  margin: 18rpx 0 26rpx;
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.user-profile-list {
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  background: var(--app-surface-soft);
}

.user-profile-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.user-profile-row:last-child {
  border-bottom: 0;
}

.user-profile-label {
  flex: none;
  width: 120rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.user-profile-value {
  flex: 1;
  color: var(--app-text-value);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.user-profile-appearance {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--app-divider);
}

/* 当前项目：收起态是「标签 + 当前项目 + 箭头」，点击后弹出 t-picker 滚轮选择器。 */
.user-profile-projects {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--app-divider);
}

.project-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  transition: opacity 120ms ease;
}

.project-trigger-active {
  opacity: 0.6;
}

.project-trigger-label {
  flex: none;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.project-trigger-value {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.project-trigger-text {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-trigger-empty {
  color: var(--app-text-placeholder);
  font-weight: 400;
}

.project-arrow {
  flex: none;
  color: var(--app-brand-icon);
}

/* 收起态是「标签 + 当前档位 + 箭头」，展开态在下方列出三档（与筛选下拉一致的交互）。 */
.appearance-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  transition: opacity 120ms ease;
}

.appearance-trigger-active {
  opacity: 0.6;
}

.appearance-trigger-label {
  flex: none;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.appearance-trigger-value {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.appearance-trigger-text {
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
}

.appearance-arrow {
  flex: none;
  color: var(--app-brand-icon);
}

.user-profile-records {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 20rpx;
  background: var(--app-surface-soft);
  transition: background 120ms ease;
}

.user-profile-records-active {
  background: var(--app-brand-soft);
}

.records-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.records-entry-text {
  color: var(--app-brand-text);
  font-size: 26rpx;
  font-weight: 550;
}

.records-icon {
  color: var(--app-brand-icon);
}

.records-arrow {
  color: var(--app-text-placeholder);
}

.share-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
  color: var(--app-on-brand);
}

.share-fab::after {
  border: 0;
}

