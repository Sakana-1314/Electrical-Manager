.home-page {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 品牌头图：与绑定页（pages/bind）同一套品牌面板语言，深色渐变 + 轨道装饰。
 * 标题、身份入口与扫码主操作都收进头图，首屏先立住品牌，再往下铺功能入口。 */
.brand-panel {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  padding: 34rpx 34rpx 36rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 14% 12%, var(--app-on-brand-glow), transparent 25%),
    var(--app-brand-strong-gradient);
  box-shadow: 0 20rpx 48rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.brand-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-eyebrow {
  flex: none;
  opacity: 0.72;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-title {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.brand-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.brand-orbit {
  position: absolute;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 50%;
}

.brand-orbit-large {
  right: -112rpx;
  bottom: -184rpx;
  width: 380rpx;
  height: 380rpx;
  box-shadow:
    0 0 0 56rpx var(--app-on-brand-ring),
    0 0 0 112rpx var(--app-on-brand-ring-soft);
}

.brand-orbit-small {
  top: -48rpx;
  right: 82rpx;
  width: 112rpx;
  height: 112rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 220rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 999rpx;
  background: var(--app-on-brand-glow);
}

.operator-badge-active,
.action-card-active,
.scan-card-active {
  transform: scale(0.98);
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-on-brand);
  box-shadow: 0 0 0 6rpx var(--app-on-brand-ring);
}

.operator-name {
  overflow: hidden;
  color: var(--app-on-brand);
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-chevron {
  color: var(--app-on-brand-soft);
}

/* 功能入口网格：两列等宽大卡；入口数量为奇数时最后一张居中，不留半行空位。 */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

/* 首屏加载态：占住入口区域的高度，加载完成时入口一次性就位，不会把页面顶上去。 */
.state-panel {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.failed-panel {
  flex-direction: column;
  gap: 24rpx;
}

/* 扫码出库：头图内的玻璃卡，整张可点，是首页唯一的主动作。
 * 图标用白色实底方片与深蓝渐变拉开对比，箭头收在圆形描边里。 */
.scan-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 32rpx;
  padding: 24rpx;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 24rpx;
  background: var(--app-on-brand-glow);
  transition: transform 120ms ease;
}

.scan-icon {
  display: flex;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--app-on-brand);
  color: var(--app-brand);
}

/* 扫码中：图标原地旋转。图标是白色的实底方片，主色图标直接可见。 */
.scan-spinner {
  animation: scan-spin 900ms linear infinite;
}

@keyframes scan-spin {
  to {
    transform: rotate(360deg);
  }
}

.scan-content {
  flex: 1;
  min-width: 0;
}

.scan-title {
  color: var(--app-on-brand);
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.scan-description {
  margin-top: 6rpx;
  color: var(--app-on-brand-soft);
  font-size: 23rpx;
  line-height: 1.4;
}

.scan-arrow {
  display: flex;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 50%;
  color: var(--app-on-brand);
}

/* 入口分组标题：小色条 + 一行字，把品牌头图与下方功能列表分开。 */
.section-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 40rpx 4rpx 20rpx;
}

.section-label-bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--app-brand);
}

.section-label-text {
  color: var(--app-text-title);
  font-size: 28rpx;
  font-weight: 650;
}

/* 功能入口卡：两列等宽、图标在上、文案在下的竖版大卡；
 * 所有入口共用一套版式与配色，只按功能开关决定显隐，不区分主次。 */
.action-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: calc(50% - 10rpx);
  min-height: 272rpx;
  padding: 30rpx 26rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 28rpx;
  background: var(--app-surface-gradient);
  box-shadow: 0 16rpx 36rpx var(--app-brand-shadow-color-soft);
  transition: transform 120ms ease;
}

.action-icon {
  display: flex;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.action-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: flex-end;
  min-width: 0;
  margin-top: 22rpx;
}

.action-title {
  overflow: hidden;
  color: var(--app-text-title);
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.action-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: left;
}

.user-profile-popup {
  box-sizing: border-box;
  width: 620rpx;
  /* 小屏上内容（外观可选列表展开后）可能高过屏幕，让弹窗自身可滚动。 */
  max-height: 78vh;
  padding: 42rpx 34rpx 30rpx;
  overflow-y: auto;
  border-radius: 28rpx;
  background: var(--app-surface);
}

.user-profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.user-profile-title {
  margin: 18rpx 0 26rpx;
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.user-profile-list {
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  background: var(--app-surface-soft);
}

.user-profile-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.user-profile-row:last-child {
  border-bottom: 0;
}

.user-profile-label {
  flex: none;
  width: 120rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.user-profile-value {
  flex: 1;
  color: var(--app-text-value);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.user-profile-appearance {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--app-divider);
}

/* 当前项目：收起态是「标签 + 当前项目 + 箭头」，点击后弹出 t-picker 滚轮选择器。 */
.user-profile-projects {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--app-divider);
}

.project-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  transition: opacity 120ms ease;
}

.project-trigger-active {
  opacity: 0.6;
}

.project-trigger-label {
  flex: none;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.project-trigger-value {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.project-trigger-text {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-trigger-empty {
  color: var(--app-text-placeholder);
  font-weight: 400;
}

.project-arrow {
  flex: none;
  color: var(--app-brand-icon);
}

/* 收起态是「标签 + 当前档位 + 箭头」，展开态在下方列出三档（与筛选下拉一致的交互）。 */
.appearance-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  transition: opacity 120ms ease;
}

.appearance-trigger-active {
  opacity: 0.6;
}

.appearance-trigger-label {
  flex: none;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.appearance-trigger-value {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.appearance-trigger-text {
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
}

.appearance-arrow {
  flex: none;
  color: var(--app-brand-icon);
}

.user-profile-records {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 20rpx;
  background: var(--app-surface-soft);
  transition: background 120ms ease;
}

.user-profile-records-active {
  background: var(--app-brand-soft);
}

.records-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.records-entry-text {
  color: var(--app-brand-text);
  font-size: 26rpx;
  font-weight: 550;
}

.records-icon {
  color: var(--app-brand-icon);
}

.records-arrow {
  color: var(--app-text-placeholder);
}

.share-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
  color: var(--app-on-brand);
}

.share-fab::after {
  border: 0;
}

