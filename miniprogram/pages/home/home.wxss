.home-page {
  padding: 24rpx 24rpx calc(184rpx + env(safe-area-inset-bottom));
}

/* 品牌头图：与绑定页（pages/bind）同一套品牌面板语言，深色渐变 + 轨道装饰。
 * 标题、身份入口与扫码主操作都收进头图，首屏先立住品牌，再往下铺功能入口。 */
.brand-panel {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  padding: 34rpx 34rpx 36rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 14% 12%, var(--app-on-brand-glow), transparent 25%),
    var(--app-brand-strong-gradient);
  box-shadow: 0 20rpx 48rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.brand-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-eyebrow {
  flex: none;
  opacity: 0.72;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-title {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.brand-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.brand-orbit {
  position: absolute;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 50%;
}

.brand-orbit-large {
  opacity: 0.18;
  right: -112rpx;
  bottom: -184rpx;
  width: 380rpx;
  height: 380rpx;
  box-shadow:
    0 0 0 56rpx var(--app-on-brand-ring),
    0 0 0 112rpx var(--app-on-brand-ring-soft);
}

.brand-orbit-small {
  top: -48rpx;
  right: 82rpx;
  width: 112rpx;
  height: 112rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 220rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 999rpx;
  background: var(--app-on-brand-glow);
}

.operator-badge-active,
.action-card-active,
.scan-card-active {
  transform: scale(0.98);
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-on-brand);
  box-shadow: 0 0 0 6rpx var(--app-on-brand-ring);
}

.operator-name {
  overflow: hidden;
  color: var(--app-on-brand);
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-chevron {
  color: var(--app-on-brand-soft);
}

/* 功能入口网格：两列等宽紧凑卡；入口数量为奇数时最后一张靠左，不居中留空。 */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

/* 首屏加载态：占住入口区域的高度，加载完成时入口一次性就位，不会把页面顶上去。 */
.state-panel {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
}

.failed-panel {
  flex-direction: column;
  gap: 24rpx;
}

/* 扫码出库：头图内的玻璃卡，整张可点，是首页唯一的主动作。
 * 图标用白色实底方片与深蓝渐变拉开对比，箭头收在圆形描边里。 */
.scan-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 32rpx;
  padding: 24rpx;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 24rpx;
  background: var(--app-on-brand-glow);
  transition: transform 120ms ease;
}

.scan-icon {
  display: flex;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--app-on-brand);
  color: var(--app-brand);
}

/* 扫码中：图标原地旋转。图标是白色的实底方片，主色图标直接可见。 */
.scan-spinner {
  animation: scan-spin 900ms linear infinite;
}

@keyframes scan-spin {
  to {
    transform: rotate(360deg);
  }
}

.scan-content {
  flex: 1;
  min-width: 0;
}

.scan-title {
  color: var(--app-on-brand);
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.scan-description {
  margin-top: 6rpx;
  color: var(--app-on-brand-soft);
  font-size: 23rpx;
  line-height: 1.4;
}

.scan-arrow {
  display: flex;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--app-on-brand-line);
  border-radius: 50%;
  color: var(--app-on-brand);
}

/* 入口分组标题：小色条 + 一行字，把品牌头图与下方功能列表分开。 */
.section-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 40rpx 4rpx 20rpx;
}

.section-label-bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--app-brand);
}

.section-label-text {
  color: var(--app-text-title);
  font-size: 28rpx;
  font-weight: 650;
}

/* 功能入口卡：图标与标题同一行、说明在下方；两列等宽，所有入口共用一套版式与配色。 */
.action-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: calc(50% - 8rpx);
  padding: 26rpx 24rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 26rpx;
  background: var(--app-surface-gradient);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-soft);
  transition: transform 120ms ease;
}

/* 图标与标题组成同一行，让图标落在标题的视觉基线上，不再单独悬浮在卡片上半区。 */
.action-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.action-icon {
  display: flex;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--app-brand-soft);
  color: var(--app-brand);
}

.action-title {
  flex: 1;
  overflow: hidden;
  color: var(--app-text-title);
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 分享按钮固定在左下角，与列表页「返回顶部」FAB 同一位置与尺寸；
 * 页面底部预留了 FAB 高度，避免滚到底时压住最后一行入口。 */
.share-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
  color: var(--app-on-brand);
}

.share-fab::after {
  border: 0;
}
