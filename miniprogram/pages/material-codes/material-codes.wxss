.material-codes-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header { margin: 4rpx 4rpx 24rpx; }
.list-header .page-title { font-size: 44rpx; }

.import-time { margin: -12rpx 8rpx 20rpx; color: var(--app-text-subtle); font-size: 22rpx; }

.list-tools {
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.result-count { margin: 0 8rpx 14rpx; color: var(--app-text-muted); font-size: 23rpx; }
.code-list { display: flex; flex-direction: column; gap: 16rpx; }

.code-card {
  display: block;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 24rpx;
  background: var(--app-surface);
  box-shadow: 0 8rpx 24rpx var(--app-shadow-color);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.code-card-active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 20rpx var(--app-shadow-color-strong);
}

.code-name {
  overflow: hidden;
  color: var(--app-text-strong);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-model {
  margin-top: 8rpx;
  color: var(--app-text-subtle);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.card-divider {
  height: 2rpx;
  margin: 16rpx 0 14rpx;
  background: var(--app-divider);
}

.code-value {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: var(--app-text-placeholder); font-size: 22rpx; text-align: center; }

.back-top-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
}

.back-top-fab::after {
  border: 0;
}

.detail-popup {
  box-sizing: border-box;
  width: 640rpx;
  max-height: 80vh;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: var(--app-surface);
  overflow-y: auto;
}

.detail-title {
  margin-bottom: 22rpx;
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-rows { display: flex; flex-direction: column; }

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--app-divider);
}

.detail-row:last-child { border-bottom: 0; }

.detail-label {
  flex: none;
  width: 180rpx;
  color: var(--app-text-subtle);
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-strong);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.copy-btn {
  display: flex;
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.copy-btn::after {
  border: 0;
}
