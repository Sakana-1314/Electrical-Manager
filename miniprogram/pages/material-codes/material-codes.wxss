.material-codes-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.import-time {
  margin: 0 8rpx 20rpx;
  color: var(--app-text-subtle);
  font-size: 22rpx;
}

.list-tools {
  margin-bottom: 20rpx;
  padding: 0;
}

.result-count {
  margin: 0 8rpx 14rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
}
.code-list { display: flex; flex-direction: column; gap: 16rpx; }

.code-card {
  padding: 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 24rpx;
  background: var(--app-surface);
  box-shadow: 0 10rpx 30rpx var(--app-shadow-color);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.code-card-active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 18rpx var(--app-shadow-color-strong);
}

.code-name {
  overflow: hidden;
  color: var(--app-text-strong);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-model {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.card-divider {
  height: 2rpx;
  margin: 16rpx 0 14rpx;
  background: var(--app-divider);
}

.code-value {
  overflow: hidden;
  color: var(--app-brand-text);
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: var(--app-text-placeholder); font-size: 22rpx; text-align: center; }

.back-top-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
}

.back-top-fab::after {
  border: 0;
}
