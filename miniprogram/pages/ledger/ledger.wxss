.ledger-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header { margin: 4rpx 4rpx 24rpx; }
.list-header .page-title { font-size: 44rpx; }

.list-tools {
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.result-count { margin: 0 8rpx 14rpx; color: var(--app-text-muted); font-size: 23rpx; }
.ledger-list { display: flex; flex-direction: column; gap: 16rpx; }

.ledger-card {
  padding: 28rpx 28rpx 24rpx;
  border: 2rpx solid var(--app-card-border);
  border-radius: 28rpx;
  background: var(--app-surface);
  box-shadow: 0 12rpx 36rpx var(--app-shadow-color);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.ledger-card-active { transform: scale(0.99); box-shadow: 0 6rpx 18rpx var(--app-shadow-color-strong); }
.card-heading, .ledger-meta { display: flex; align-items: center; }
.card-heading { gap: 16rpx; margin-bottom: 6rpx; }
.ledger-name { flex: 1; min-width: 0; color: var(--app-text-strong); font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.ledger-arrow { flex: none; color: var(--app-text-placeholder); }
.ledger-spec { color: var(--app-text-muted); font-size: 24rpx; line-height: 1.45; word-break: break-all; padding-left: 2rpx; }
.card-divider { height: 2rpx; margin: 22rpx 0 18rpx; background: var(--app-divider); }
.meta-item { min-width: 190rpx; }
.subitem-item { flex: 1; min-width: 0; }
.meta-label { color: var(--app-text-subtle); font-size: 21rpx; }
.quantity-value { margin-top: 4rpx; color: var(--app-brand-text); font-size: 31rpx; font-weight: 750; }
.meta-value { margin-top: 8rpx; color: var(--app-text); font-size: 25rpx; font-weight: 550; word-break: break-all; }
.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: var(--app-text-placeholder); font-size: 22rpx; text-align: center; }

.back-top-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  box-shadow: 0 12rpx 28rpx var(--app-brand-shadow-color-strong);
  line-height: 1;
}

.back-top-fab::after {
  border: 0;
}
