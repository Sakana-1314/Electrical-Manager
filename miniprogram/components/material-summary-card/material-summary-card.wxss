.material-summary-card {
  margin-bottom: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: var(--app-brand-strong-gradient);
  box-shadow: 0 18rpx 44rpx var(--app-brand-strong-shadow-color);
  color: var(--app-on-brand);
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.material-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.material-spec {
  margin-top: 10rpx;
  color: var(--app-on-brand-soft);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--app-on-brand-line);
}

.stock-label {
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
}

.stock-number {
  margin-top: 4rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stock-unit {
  padding-bottom: 8rpx;
  color: var(--app-on-brand-soft);
  font-size: 28rpx;
  font-weight: 550;
}

.minimum-tip {
  margin-top: 12rpx;
  color: var(--app-on-brand-soft);
  font-size: 24rpx;
  line-height: 1.4;
}
