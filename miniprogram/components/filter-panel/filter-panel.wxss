/* 筛选栏：搜索占满剩余宽度，右侧是一个固定宽度的筛选按钮（带已选数量角标）。 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-search {
  flex: 1;
  min-width: 0;
}

.filter-trigger {
  position: relative;
  display: flex;
  flex: none;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--app-card-border);
  border-radius: 20rpx;
  background: var(--app-surface);
  color: var(--app-text-muted);
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.filter-trigger-active {
  border-color: var(--app-brand-border);
  background: var(--app-brand-soft);
  color: var(--app-brand-text);
}

.filter-trigger-hover {
  background: var(--app-brand-soft-active);
}

/* 角标只是数量提示，压在按钮右上角，不撑高按钮本身。 */
.filter-trigger-count {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
}

/* 已选条件：一行横向滚动，超出时可滑，不换行占掉两行高度。 */
.filter-chips {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.filter-chips-track {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 8rpx;
}

.filter-chip {
  display: inline-flex;
  flex: none;
  align-items: center;
  gap: 6rpx;
  max-width: 420rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--app-brand-border);
  border-radius: 999rpx;
  background: var(--app-brand-soft);
  color: var(--app-brand-text);
  font-size: 22rpx;
}

.filter-chip-hover {
  opacity: 0.7;
}

.filter-chip-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-chip-close {
  flex: none;
  color: var(--app-brand-icon);
}

.filter-chip-clear {
  flex: none;
  padding: 8rpx 12rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
}

/* 底部面板：圆角只给上沿，与页面底色拉开层次；内容区可滚动，操作区固定在最下方。 */
.filter-sheet {
  display: flex;
  box-sizing: border-box;
  max-height: 76vh;
  flex-direction: column;
  padding: 12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  background: var(--app-surface);
}

.filter-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}

.filter-sheet-title {
  color: var(--app-text-strong);
  font-size: 32rpx;
  font-weight: 650;
}

.filter-sheet-close {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  color: var(--app-text-muted);
}

.filter-sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.filter-section {
  padding: 18rpx 0 6rpx;
}

.filter-section-title {
  margin-bottom: 14rpx;
  color: var(--app-text-subtle);
  font-size: 23rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 选项是胶囊按钮：选中态用主色浅底 + 描边，未选中保持中性，避免整屏都是蓝块。 */
.filter-option {
  box-sizing: border-box;
  max-width: 100%;
  padding: 14rpx 26rpx;
  overflow: hidden;
  border: 2rpx solid var(--app-card-border);
  border-radius: 999rpx;
  background: var(--app-surface-soft);
  color: var(--app-text);
  font-size: 25rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.filter-option-hover {
  background: var(--app-brand-soft-active);
}

.filter-option-selected {
  border-color: var(--app-brand);
  background: var(--app-brand-soft);
  color: var(--app-brand-text);
  font-weight: 600;
}

.filter-sheet-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--app-divider);
}

.filter-action {
  flex: 1;
}
